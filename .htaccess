Options -Indexes
<FilesMatch "^(config\.php|schema\.sql|README\.txt)$|\.(sql|gz|bak|log|zip|md)$">
  Require all denied
</FilesMatch>

# Compression and caching for static files (ignored if the host lacks these modules)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
